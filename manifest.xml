<!-- The software keymaster 4.0 service has no manifest fragment of its own.
     Wi-Fi and supplicant install their own fragments; do not declare them here. -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>

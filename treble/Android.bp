
// blobs NEED but a Treble vendor namespace cannot reach.  Measured with


// (../Android.bp), so no other product ever sees these modules.

cc_defaults {
    name: "m5c_treble_defaults",
    vendor: true,
    cflags: ["-Wall", "-Werror"],
}

// libgui.so -> libgui_vendor.so (lesson 6 of the m95 port, same mechanism as
// libgui_m95 in device/meizu/m95/shims/Android.bp).

// libcam.utils.sensorlistener, libcamalgo, ...) NEED libgui.so, and libgui is
// VNDK-PRIVATE in Android 13 (vndkprivate.libraries.33.txt), i.e. not linked
// into the vendor namespace at all.  The m5c blobs were never rewired to a
// device-specific soname the way m95's were, so the forwarder carries the
// real name: an empty library, soname libgui.so, whose DT_NEEDED is the AOSP
// vendor build of libgui.  The vendor namespace finds /vendor/lib*/libgui.so
// in its own search path; bionic then binds the consumers' symbols across the
// whole local group, i.e. into libgui_vendor (bionic/linker/linker.cpp,
// the m95 model check: one libgui instance per process).
// The N-era libgui symbols Android 13 no longer exports come from
// libm5cshim_camera (camera.cpp), wired to the consumers.
cc_library_shared {
    name: "libgui_m5c_fwd",
    defaults: ["m5c_treble_defaults"],
    stem: "libgui",
    srcs: ["stub.cpp"],
    shared_libs: ["libgui_vendor"],
}

// libnativehelper.so as an EMPTY vendor library.

// the ART apex, out of the vendor namespace's reach.  Of those 39, only
// libem_bt_jni and libmeizucamera (both ABIs) import anything from it
// (jniThrowException, jniThrowRuntimeException, jniGetFDFromFileDescriptor);
// both are JNI libraries for apps this image does not carry.  The other 35 —
// the audio chain under audio.primary.mt6737m (libaudiocompensationfilter,
// libaudiocomponentengine, libaudiodcrflt, ...) among them — import zero
// symbols: it is overlink.  Under Treble an empty library with the real name
// cannot shadow anything: no vendor or sphal process can see the ART copy,
// and app namespaces do not search /vendor.
cc_library_shared {
    name: "libnativehelper_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libnativehelper",

    // closure) imports — see nativehelper.cpp.
    srcs: ["nativehelper.cpp"],
}

// android::Region with the N/M object layout for the Mali EGL driver
// (region.cpp).  Mali's DT_NEEDED libui.so is rewritten to this library at
// build time by vendor/meizu/m5c (treble-elf-wiring.txt): libui.so stays out
// of sphal on purpose (system/linkerconfig meizu-legacy-vendor 0dcdd17).
cc_library_shared {
    name: "libm5cshim_region",
    defaults: ["m5c_treble_defaults"],
    srcs: ["region.cpp"],
    cflags: ["-fvisibility=hidden"],
}

// __xlog_buf_printf, android_memset16, __pthread_gettid, PermissionCache and
// the RIL's netutils / jstring symbols - see legacy.cpp.
// Added to the consumers' DT_NEEDED the same way.  Only liblog (LLNDK), so it
// loads in sphal as well as in the vendor namespace.
cc_library_shared {
    name: "libm5cshim_legacy",
    defaults: ["m5c_treble_defaults"],
    srcs: ["legacy.cpp"],
    shared_libs: ["liblog"],
    cflags: ["-fvisibility=hidden"],
}



// never opens — the blob NEEDs libmedia.so, libpowermanager.so and
// libtinycompress.so, none of which a vendor process can load, and
// `dumpsys media.audio_policy` lists no output device (system_server then
// logs "AudioSystem::listAudioPorts error -19" ten times a second).
//
// libmedia.so: the nine AudioSystem statics the HAL imports (audiosystem.cpp).
// libpowermanager.so: overlink — the HAL imports nothing from it
// (acquire/release_wake_lock come from libhardware_legacy).  Both platform
// libraries are system-only, so the real names cannot shadow anything, the
// same reasoning as libnativehelper above.  libmedia.so is also NEEDed by
// libhdrproc, libfilterfw, radio.fm.mt6737m and meta_tst; they now get past
// the soname and stand or fall on their own imports.
cc_library_shared {
    name: "libmedia_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libmedia",
    srcs: ["audiosystem.cpp"],
}

cc_library_shared {
    name: "libpowermanager_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libpowermanager",
    srcs: ["stub.cpp"],
}

// libtinycompress.so is a vendor module of AOSP (external/tinycompress), so
// its install path is taken; the HAL's DT_NEEDED is rewritten to this name
// instead (treble-elf-wiring.txt).  See tinycompress.cpp.
cc_library_shared {
    name: "libm5cshim_tinycompress",
    defaults: ["m5c_treble_defaults"],
    srcs: ["tinycompress.cpp"],
}

// SSLv3_{client,server}_method for libcurl (mnld); see ssl.cpp.  mtk_agpsd is
// wired to it too but not started (init.m5c.gps.rc).
// libssl is VNDK, so this loads in the vendor namespace.
cc_library_shared {
    name: "libm5cshim_ssl",
    defaults: ["m5c_treble_defaults"],
    srcs: ["ssl.cpp"],
    shared_libs: ["libssl"],
}

// Camera HAL closure (camera.mt6737m.so, 32-bit provider; both ABIs built).

// libmeizucamera and 31 symbols unresolved across libcam_utils,
// libmtk_mmutils, libmmsdkservice.feature, libcam.utils.sensorlistener and
// libmeizucamera.  Sources say which and why:
//   android_runtime.cpp  AndroidRuntime::getJNIEnv / registerNativeMethods
//                        (real name: the platform library is system-only)
//   camera.cpp           PropertyMap, N GraphicBuffer ctors + lock, N
//                        BufferQueue / BufferItemConsumer / Surface, N
//                        SensorManager ctor, SensorEventQueue::getFd,
//                        IPermissionController::asInterface
//   newpad.cpp           operator new with slack for the N-sized
//                        GraphicBuffer / BufferItemConsumer blocks, and
//                        Thread::run with a default name (A13 aborts on NULL)
// libm5cshim_camera and libm5cshim_newpad are wired to the consumers at
// build time (vendor/meizu/m5c treble-elf-wiring.txt).
cc_library_shared {
    name: "libandroid_runtime_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libandroid_runtime",
    srcs: ["android_runtime.cpp"],
}

// libcam.common.meizu and libmpbase (camera open-time closure, dlopen of
// libcam_platform) NEED libandroid.so and libjnigraphics.so and import nothing

// system-only; empty libraries with the real names cannot shadow anything in
// a vendor process.
cc_library_shared {
    name: "libandroid_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libandroid",
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libjnigraphics_m5c_stub",
    defaults: ["m5c_treble_defaults"],
    stem: "libjnigraphics",
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm5cshim_camera",
    defaults: ["m5c_treble_defaults"],
    srcs: ["camera.cpp"],
    shared_libs: [
        "libgui_vendor",
        "liblog",
        "libsensor_vendor",
        "libui",
        "libutils",
    ],
}

cc_library_shared {
    name: "libm5cshim_newpad",
    defaults: ["m5c_treble_defaults"],
    srcs: ["newpad.cpp"],
    stl: "none",
}

// libnetd_client.so for volte_stack (netd_client.c): setNetworkForSocket
// forwarded to the LLNDK android_setsocknetwork.  ELF32 only: the one consumer,
// the stock volte_stack, is 32-bit.
cc_library_shared {
    name: "libm5cshim_netd_client",
    defaults: ["m5c_treble_defaults"],
    stem: "libnetd_client",
    srcs: ["netd_client.c"],
    shared_libs: ["libandroid_net"],
    compile_multilib: "32",
}

// android::Pbrcel for the boxed 64-bit librilmtk (nparcel.cpp;
// vendor/meizu/m5c blob-parcel-box.py adds this library to its DT_NEEDED).
// 64-bit only: rild and its librilmtk are 64-bit (rild.libpath, vendor.prop).
cc_library_shared {
    name: "libm5cshim_nparcel",
    defaults: ["m5c_treble_defaults"],
    srcs: ["nparcel.cpp"],
    cflags: ["-fvisibility=hidden"],
    shared_libs: [
        "libbinder",
        "libutils",
    ],
    compile_multilib: "64",
}

// jniRegisterNativeMethods for the stock M libwfo_jni (jnihelp.cpp; vendor/
// meizu/m5c blob-elf-wire.py swaps its libnativehelper.so NEEDED for this).
// 64-bit only: its one loader, ForgeImsService, runs in the 64-bit phone uid.
cc_library_shared {
    name: "libm5cshim_jnihelp",
    defaults: ["m5c_treble_defaults"],
    srcs: ["jnihelp.cpp"],
    cflags: ["-fvisibility=hidden"],
    header_libs: ["jni_headers"],
    shared_libs: ["liblog"],
    compile_multilib: "64",
}

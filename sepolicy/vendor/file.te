# Types for the m5c (MT6737M, 4.9 kernel, N-era MTK blobs) vendor policy.
# Structure and most names follow m95 (device/meizu/m95/sepolicy/vendor,


# Exec types of domains with a .te file of their own (msensord, akmd,
# mtk_fusiond, pq, thermal_manager) are declared there.

# Block devices (by-name, mtk-msdc.0/11230000.msdc0)
type nvram_device, dev_type;
type nvdata_device, dev_type;
type protect_f_device, dev_type;
type protect_s_device, dev_type;
type expdb_block_device, dev_type;
type logo_block_device, dev_type;
type seccfg_block_device, dev_type;
type proinfo_block_device, dev_type;
type lk_block_device, dev_type;

# Character devices
type stpwmt_device, dev_type;
type wmtdetect_device, dev_type;
type wmtWifi_device, dev_type;
type stpbt_device, dev_type;
type stpgps_device, dev_type;
type fm_device, dev_type;
type ccci_device, dev_type;
type sw_sync_device, dev_type;
type MTK_SMI_device, dev_type;
type camera_isp_device, dev_type;
type cam_cal_device, dev_type;
type hwmsensor_device, dev_type;
type mtgpio_device, dev_type;
type touch_device, dev_type;
type hotknot_device, dev_type;
type hang_detect_device, dev_type;
type devmap_device, dev_type;
type accdet_device, dev_type;
type mtk_adc_cali_device, dev_type;
type m5c_spm_device, dev_type;

# Mount points / data
type nvdata_file, file_type, data_file_type, core_data_file_type;
type protect_f_data_file, file_type, data_file_type;
type protect_s_data_file, file_type, data_file_type;
type mnld_data_file, file_type, data_file_type, core_data_file_type;
type mtk_sensor_data_file, file_type, data_file_type, core_data_file_type;
type sensor_calib_file, file_type, data_file_type, core_data_file_type;
type ccci_cfg_file, file_type, data_file_type, core_data_file_type;
type thermal_data_file, file_type, data_file_type, core_data_file_type;
type m5c_bt_data_file, file_type, data_file_type;

# proc / sysfs
type mtk_m4u_proc, fs_type, proc_type;
type mtk_wmt_proc, fs_type, proc_type;
type proc_ged, fs_type, proc_type;
type proc_cmdq, fs_type, proc_type;
type proc_mtk_thermal, fs_type, proc_type;
type m5c_proc_swappiness, fs_type, proc_type;
# /proc/forge_bootguard of the m5c test kernels (forge_m5c_bootguard.c): init
# writes 0 on sys.boot_completed to clear the BCB it arms in para.
type m5c_proc_bootguard, fs_type, proc_type;
# /proc/hps/num_base_perf_serv and /proc/gpufreq/gpufreq_opp_freq, written by
# the Power HAL during an interaction (power/Power.cpp).
type m5c_proc_perf_boost, fs_type, proc_type;
type m5c_proc_last_kmsg, fs_type, proc_type;
type m5c_proc_mira, fs_type, proc_type;
type sysfs_ccci, fs_type, sysfs_type;
type sysfs_dev_info, fs_type, sysfs_type;
type sysfs_mtk_sensor, fs_type, sysfs_type;
type m5c_sysfs_mem_bw, fs_type, sysfs_type;
type m5c_sysfs_virtualkeys, fs_type, sysfs_type;


type sysfs_fw_class_path, fs_type, sysfs_type;

# Executables of the vendor daemons and scripts
type nvram_daemon_exec, exec_type, vendor_file_type, file_type;
type wmt_loader_exec, exec_type, vendor_file_type, file_type;
type wmt_launcher_exec, exec_type, vendor_file_type, file_type;
type mnld_exec, exec_type, vendor_file_type, file_type;
type ccci_fsd_exec, exec_type, vendor_file_type, file_type;
type ccci_mdinit_exec, exec_type, vendor_file_type, file_type;
type gsm0710muxd_exec, exec_type, vendor_file_type, file_type;
type muxreport_exec, exec_type, vendor_file_type, file_type;
type terservice_exec, exec_type, vendor_file_type, file_type;
type m5c_bdaddr_exec, exec_type, vendor_file_type, file_type;
type m5c_spm_exec, exec_type, vendor_file_type, file_type;
type mtkmal_exec, exec_type, vendor_file_type, file_type;
type volte_ua_exec, exec_type, vendor_file_type, file_type;
type volte_stack_exec, exec_type, vendor_file_type, file_type;
type volte_imcb_exec, exec_type, vendor_file_type, file_type;

# Sockets
type rild_oem_socket, file_type;
type rild_ims_socket, file_type;
type rild_mal_socket, file_type;

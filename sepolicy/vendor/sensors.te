# Sensors: the HAL (hal_sensors_default, with group input via
# init.m5c.sensors.rc) and the compass / fusion daemons of the same rc.
allow hal_sensors_default hwmsensor_device:chr_file rw_file_perms;
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file r_file_perms;
allow hal_sensors_default sysfs_mtk_sensor:dir r_dir_perms;
allow hal_sensors_default sysfs_mtk_sensor:file rw_file_perms;
allow hal_sensors_default mtk_sensor_data_file:dir create_dir_perms;
allow hal_sensors_default mtk_sensor_data_file:file create_file_perms;
allow hal_sensors_default sensor_calib_file:file create_file_perms;
r_dir_file(hal_sensors_default, nvdata_file)
get_prop(hal_sensors_default, m5c_sensor_prop)
# Driver attributes outside the m_*_misc devices (m95 template; nodes not
# recorded).
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs:file r_file_perms;

# msensord starts the compass daemon the kernel names in
# /sys/bus/platform/drivers/msensor/daemon (akmd09912 on this unit) with
# ctl.start and polls init.svc.<name> until it runs; both property sets have
# types of their own (property_contexts).
type msensord, domain;
type msensord_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(msensord)
allow msensord hwmsensor_device:chr_file rw_file_perms;
allow msensord sysfs_mtk_sensor:dir r_dir_perms;
allow msensord sysfs_mtk_sensor:file r_file_perms;
allow msensord sysfs:file r_file_perms;
set_prop(msensord, m5c_ctl_sensor_prop)
get_prop(msensord, m5c_sensor_svc_prop)
get_prop(msensord, m5c_sensor_prop)

# akmd09911 (AKM compass daemon, both service names).
type akmd, domain;
type akmd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(akmd)
allow akmd hwmsensor_device:chr_file rw_file_perms;
allow akmd input_device:dir r_dir_perms;
allow akmd input_device:chr_file rw_file_perms;
allow akmd sysfs_mtk_sensor:dir r_dir_perms;
allow akmd sysfs_mtk_sensor:file rw_file_perms;
allow akmd sensor_calib_file:file create_file_perms;
allow akmd mtk_sensor_data_file:dir create_dir_perms;
allow akmd mtk_sensor_data_file:file create_file_perms;
# /data/misc/akmd_set.txt lives directly in /data/misc.
allow akmd system_data_file:dir search;
set_prop(akmd, m5c_sensor_prop)

# geomagneticd / orientationd (MTK software fusion).
type mtk_fusiond, domain;
type mtk_fusiond_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(mtk_fusiond)
allow mtk_fusiond hwmsensor_device:chr_file rw_file_perms;
allow mtk_fusiond input_device:dir r_dir_perms;
allow mtk_fusiond input_device:chr_file rw_file_perms;
get_prop(mtk_fusiond, m5c_sensor_prop)

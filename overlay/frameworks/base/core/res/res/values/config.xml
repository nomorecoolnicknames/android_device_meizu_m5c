<?xml version="1.0" encoding="utf-8"?>
<!--
     Device overlay for the Meizu M5c (m5c, M710H) — LineageOS 20.0.

     Every value here is carried from the 14.1 overlay that runs on the device
     today (<private-workspace>/m5c/android_device_meizu_m5c/overlay/
     frameworks/base/core/res/res/values/config.xml).  Names were checked
     one by one against this tree's frameworks/base/core/res/res/values before
     being copied; the following entries from the 14.1 overlay were DROPPED
     because the resource no longer exists in Android 13 and an unknown name
     is an aapt2 error, not a no-op:

       config_wifi_background_scan_support   (gone)
       config_dozeAfterScreenOff             (gone)
       config_intrusiveBatteryLed            (gone)
       config_deviceHardwareKeys             (moved to lineage-sdk — it is
                                              overlaid in the lineage-sdk
                                              overlay next to this file)

     Not carried on purpose:
       config_wifi_dual_band_support — MT6735 CONSYS is 2.4 GHz only on this
       unit; the 14.1 value was copy-paste from another board.  HYPOTHESIS to
       disprove if 5 GHz ever appears in a scan.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Backlight: measured LUX/backlight pairs from the 14.1 tree. -->
    <integer name="config_screenBrightnessSettingMinimum">3</integer>
    <integer name="config_screenBrightnessDim">20</integer>
    <bool name="config_automatic_brightness_available">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>200</item>
        <item>320</item>
        <item>450</item>
        <item>580</item>
        <item>700</item>
        <item>850</item>
        <item>950</item>
        <item>1500</item>
        <item>3000</item>
        <item>5000</item>
        <item>7000</item>
        <item>9000</item>
        <item>11000</item>
        <item>13000</item>
        <item>15000</item>
        <item>17000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>1</item>
        <item>12</item>
        <item>91</item>
        <item>103</item>
        <item>107</item>
        <item>113</item>
        <item>120</item>
        <item>129</item>
        <item>134</item>
        <item>152</item>
        <item>224</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Dual SIM, both slots hot-swappable. -->
    <bool name="config_hotswapCapable">true</bool>

    <bool name="config_unplugTurnsOnScreen">true</bool>

    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>rndis\\d</item>
    </string-array>

    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>ap0</item>
    </string-array>

    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>bt-pan</item>
    </string-array>

    <bool name="config_cellBroadcastAppLinks">true</bool>
    <bool name="config_safe_media_volume_enabled">true</bool>
    <bool name="config_dreamsEnabledByDefault">true</bool>

    <!-- stk3x1x proximity sensor is live on this unit (PID=0x15). -->
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>

    <!-- Doze / power -->
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <integer name="config_screenBrightnessDoze">3</integer>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_nightDisplayAvailable">true</bool>

    <!-- No double-tap-to-wake support in the ILI9881C / GT917D stack. -->
    <bool name="config_supportDoubleTapWake">false</bool>

    <!-- RGB notification LED exists in hardware but is NOT yet driven by the
         4.9 kernel (component matrix 2026-09-03: "RGB-индикатор — не заведён
         в 4.9").  The setting is left on so the UI appears once the driver
         lands; if it stays dark this is the line to flip. -->
    <bool name="config_intrusiveNotificationLed">true</bool>
    <color name="config_defaultNotificationColor">#ff0000ff</color>

    <bool name="config_enableWifiDisplay">false</bool>
</resources>

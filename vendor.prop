
# --- Platform identity (used by hw_get_module lookups) ---------------------
ro.board.platform=mt6737m
ro.mediatek.platform=MT6737M
ro.mediatek.chip_ver=S01
ro.mediatek.version.sdk=4
ro.mediatek.version.release=ZAL856_999A_V0_0_5_BSP_20170605
ro.meizu.product.model=M5c
ro.meizu.project.id=m1710-5
ro.product.flyme.model=m1710

# --- MTK combo chip (Wi-Fi / BT / GPS / FM share one CONSYS) ---------------
persist.mtk.wcn.combo.chipid=-1
persist.mtk.wcn.fwlog.status=0
service.wcn.driver.ready=no
persist.mtk.combo.coredump=no

# --- Wi-Fi ----------------------------------------------------------------
mediatek.wlan.chip=CONSYS_MT6735
mediatek.wlan.module.postfix=_consys_mt6735
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.interface=wlan0
wifi.direct.interface=p2p0

# --- Bluetooth ------------------------------------------------------------
ro.mtk_bt_support=1
# Factory address from NVRAM, written at boot by /vendor/bin/m5c-bdaddr.sh
# (init.m5c.nvram.rc).  First source the AOSP HAL reads
# (hardware/interfaces/bluetooth/1.0/default/bluetooth_address.cc:50);
# exported_bluetooth_prop, so vendor_init may set it — unlike
# persist.service.bdroid.bdaddr, which a vendor domain may not.
ro.bt.bdaddr_path=/data/vendor/bluetooth/bdaddr

# --- Telephony (dual SIM, LTE) --------------------------------------------
# rild.libpath points into /vendor now that there is a real vendor partition.
rild.libpath=/vendor/lib64/mtk-ril.so
rild.libargs=-d /dev/ttyC0
ril.specific.sm_cause=0
ro.telephony.default_network=20,20
persist.radio.multisim.config=dsds
persist.radio.default.sim=0
ro.telephony.sim.count=2
persist.radio.mobile.data=0,0
ril.external.md=0
ril.telephony.mode=0
ro.mtk_enable_md1=1
ro.mtk_lte_support=1
ril.current.share_modem=2
persist.radio.fd.counter=15
persist.radio.fd.off.counter=5
persist.radio.fd.r8.counter=15
persist.radio.fd.off.r8.counter=5
ro.mtk_gemini_support=1
persist.gemini.sim_num=2
ro.gemini.smart_sim_switch=false

# --- GPS ------------------------------------------------------------------
ro.mtk_gps_support=1
ro.mtk_agps_app=1
ro.mtk_omacp_support=1

# --- Audio ----------------------------------------------------------------
ro.mtk_audio_ape_support=1
ro.mtk_audio_tuning_tool_ver=V1
ro.vendor.audio.legacy_nougat_abi=1

debug.hwui.use_partial_updates=false

# --- Camera ---------------------------------------------------------------
# TEMPORARY: HAL3 device over the stock HAL1 module.  Android 13
# cameraservice takes HIDL devices of major version 3 only
# (CameraProviderManager.cpp:1897-1905); camera.mt6737m.so reports 0x302 for
# "3" (m5c 14.1 disassembly).  The Flyme blobs carry static metadata only for
# MTK reference sensors, so treble/camera.cpp lends this unit's S5K4H8 the
# IMX219 tables: crop, field of view and lens data are therefore not this
# sensor's.  FACT (set 20): device@3.3 opens and the preview produces frames,
# then the 4.9 kernel ISP/MDP path stalls (the same wall LOS 16 hit).  Kept at
# "3" for the kernel lane to test against; set "1" (no camera, clean) for a
# release until the kernel path and real S5K4H8 metadata exist.
debug.camera.force_device=3

# --- Bring-up diagnostics ---------------------------------------------------
# TEMPORARY: 1 MiB log rings.  With the default 256 KiB the main buffer rolled
# over within minutes of boot (FACT, set 10).  Remove for a release build.
ro.logd.size=1M

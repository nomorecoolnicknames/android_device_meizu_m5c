#
# Properties for /system/build.prop.
#

# Display density for a 720x1280 panel
ro.sf.lcd_density=320

# On-screen navigation bar: the front key only provides Home and Back.
qemu.hw.mainkeys=0

# GLES 3.0 (Mali-T720)
ro.opengles.version=196608

# Tethering
net.tethering.noprovisioning=true

# Legacy drmserver, for the forward-lock DRM plugin.
drm.service.enabled=true

# mtk-ril.so logs AT traffic and subscriber identifiers at DEBUG under the
# tags AT and RIL. For debugging: setprop log.tag.AT D (and RIL).
log.tag.AT=I
log.tag.RIL=I

# The same for the IMS tags that print subscriber data.
log.tag.WifiOffloadService=I
log.tag.MAL-IMSM=I
log.tag.VoLTE_Auto_Testing=W

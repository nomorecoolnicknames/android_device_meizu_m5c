#
# system.prop for the Meizu M5c (m5c, M710H) — LineageOS 20.0
#
# Only framework-side / system-partition properties belong here.  MTK hardware
# knobs live in vendor.prop (TARGET_VENDOR_PROP).
#
# Deliberately NOT carried from the 14.1/16 system.prop:
#   ro.product.brand / manufacturer / model / name / device / board
#     -> these are generated from PRODUCT_* by build/make/core/sysprop.mk:40-50
#        as ro.product.system.*; repeating them here is a duplicate-sysprop
#        error in Android 13 unless BUILD_BROKEN_DUP_SYSPROP is set, and there
#        is no reason to set it.
#   ro.telephony.ril_class=MT6735
#     -> BOARD_RIL_CLASS / ril_class has been dead since Android 9
#        (M5C_LOS16_TREBLE_PLAN.md §4.6); leaving it in only misleads readers.
#   debug.hwui.render_dirty_regions
#     -> no such knob exists in modern hwui; it was already a dead property on
#        Nougat.  The live replacement on this device is
#        debug.hwui.use_partial_updates (see vendor.prop; until 2026-09-16 this
#        tree misspelled it "debug.hwui.partial_updates", a name hwui never
#        reads — frameworks/base/libs/hwui/Properties.h:124) — kept because the
#        Mali-T720 blob advertises EGL_BUFFER_PRESERVED and does not honour it,
#        which shows up as a horizontal stitch mid-fling.

# Display density for a 720x1280 panel
ro.sf.lcd_density=320

# No capacitive nav bar is wired on this unit -> software keys
qemu.hw.mainkeys=0

# GLES 3.0 (Mali-T720)
ro.opengles.version=196608

# Tethering
net.tethering.noprovisioning=true

# Media / DRM: Widevine on this SoC is L3 only
drm.service.enabled=true


# Display density for a 720x1280 panel
ro.sf.lcd_density=320

# On-screen navigation bar: the front mBack key gives only Home (press, mtk-kpd)
# and Back (touch, mtk-tpd-kpd), no Recents.
qemu.hw.mainkeys=0

# GLES 3.0 (Mali-T720)
ro.opengles.version=196608

# Tethering
net.tethering.noprovisioning=true

# Legacy drmserver (not started by default on Android 13).  It loads plugins
# from /system/lib*/drm only (frameworks/av/drm/drmserver/DrmManager.cpp:214);
# the one there is AOSP's forward-lock engine, libfwdlockengine (OMA DRM v1
# ringtones/MMS; installed-files.txt).  The stock Widevine classic plugin is
# not shipped (vendor/meizu/m5c m5c-vendor-blobs.mk).  Kept as m2note/m5s.
drm.service.enabled=true

# mtk-ril.so logs at DEBUG under the tags AT and RIL: whole AT traffic
# (dialled and calling numbers, USSD, SMS PDUs), ICCID, IMSI and IMEI (set 23
# census, counts only).  A13 liblog drops a line below the tag's level before
# it reaches logd or pmsg (system/logging/liblog/logger_write.cpp:319-372).
# For a debugging session: setprop log.tag.AT D (and RIL), back to I after.
log.tag.AT=I
log.tag.RIL=I

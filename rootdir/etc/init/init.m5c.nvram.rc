
on post-fs-data
    copy /vendor/etc/fstab.mt6735 /data/nvram/fstab.mt6735
    chmod 0644 /data/nvram/fstab.mt6735

service nvram_daemon /vendor/bin/nvram_daemon
    class main
    user root
    group system
    oneshot

# Bluetooth address from NVRAM (m95 lesson, device/meizu/m95 15d2dc9).
# The AOSP BT HAL aborts with "No Bluetooth Address!" without one
# (hardware/interfaces/bluetooth/1.0/default/vendor_interface.cc:217);
# m5c-bdaddr.sh writes the NVRAM address to /data/vendor/bluetooth/bdaddr,
# named by ro.bt.bdaddr_path in vendor.prop (script header).  The HAL (user
# bluetooth) also reads BT_Addr itself through libnvram (FACT:
# lib/libbluetooth_mtk.so NEEDED libnvram.so), hence the regroup.  Both wait
# for NVRAM's own Ready flag: nvram_daemon restores BT_Addr only after
# post-fs-data, and on m95 a publisher started earlier found no file on a
# fresh /data and the HAL aborted (tombstone_18).  The script is executed
# directly, so init transitions to m5c_bdaddr on its exec label.
service m5c_bdaddr /vendor/bin/m5c-bdaddr.sh
    class core
    user root
    group root bluetooth
    oneshot
    disabled

on post-fs-data
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth

on property:service.nvram_init=Ready
    chown root bluetooth /data/nvram/APCFG/APRDEB/BT_Addr
    chmod 0660 /data/nvram/APCFG/APRDEB/BT_Addr
    start m5c_bdaddr

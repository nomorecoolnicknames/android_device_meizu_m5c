
import /vendor/etc/init/hw/init.mt6735.usb.rc

on early-init
    write /sys/module/firmware_class/parameters/path /vendor/firmware

on init
    # The kernel log only for CAP_SYSLOG.  FACT: this kernel has
    # CONFIG_SECURITY_DMESG_RESTRICT unset (IKCONFIG of the boot 61e3f822 kernel) and
    # the A13 init.rc does not set the sysctl (only kptr_restrict), so any
    # process could read dmesg; with SELinux permissive nothing else stops an
    # app.  For the bench: `adb root` or `su 0 dmesg` (userdebug).
    write /proc/sys/kernel/dmesg_restrict 1

    setprop debug.renderengine.backend gles

    write /dev/cpuctl/foreground/cpu.rt_runtime_us 400000
    write /dev/cpuctl/top-app/cpu.rt_runtime_us 200000
    write /dev/cpuctl/rt/cpu.rt_runtime_us 100000
    write /dev/cpuctl/system/cpu.rt_runtime_us 50000
    write /dev/cpuctl/system-background/cpu.rt_runtime_us 50000
    write /dev/cpuctl/background/cpu.rt_runtime_us 50000
    write /dev/cpuctl/camera-daemon/cpu.rt_runtime_us 50000

on early-boot
    chown root root /sys/power/spm/suspend_pcm
    chmod 0400 /sys/power/spm/suspend_pcm
    chown root root /sys/power/spm/dpidle_pcm
    chmod 0400 /sys/power/spm/dpidle_pcm
    chown root root /sys/power/spm/sodi_pcm
    chmod 0400 /sys/power/spm/sodi_pcm

on fs
    # The ramdisk copy of the fstab is gone after switch_root (m95 lesson,
    # device/meizu/m95/rootdir/init.mt6797.rc "cannot open file:
    # '/fstab.mt6797'"); the vendor copy is the one init can read.
    # system/vendor/metadata carry first_stage_mount and are skipped here
    # (metadata only if it is already mounted — it is formattable, so an
    # unformatted partition gets formatted here, fs_mgr.cpp:1363-1372).
    # /nvdata, /protect_f, /protect_s exist on the root (BoardConfig.mk
    # BOARD_ROOT_EXTRA_FOLDERS), their entries are nofail.
    mount_all /vendor/etc/fstab.mt6735

on post-fs
    # [LOS 16 ramdisk init.mt6735.rc, on post-fs]
    chown system system /protect_f
    chmod 0770 /protect_f
    chown system system /protect_s
    chmod 0770 /protect_s

on post-fs-data
    # zram swap declared in the fstab (see its comment).  zram-friendly VM
    # knobs as on m95 (init.m95.mem.rc): swap eagerly to compressed RAM
    # rather than evict file pages, no read-ahead clusters on swap-in.
    swapon_all /vendor/etc/fstab.mt6735
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
    # [LOS 16 ramdisk init.mt6735.rc, on post-fs-data] /data/nvram is a
    # symlink to the nvdata partition on this device.  init.m5c.nvram.rc
    # (parsed after this file) copies the fstab into it in the same trigger.
    chown root system /nvdata
    chmod 0771 /nvdata
    symlink /nvdata /data/nvram
    mkdir /nvdata/media 0771 media audio
    restorecon_recursive /nvdata
    # [LOS 16 init.mt6735.rc:532 and its mem_bw_ctrl lines] thermal_manager's
    # runtime directory and the memory-bandwidth scenario switch of the camera
    # HAL (FACT: root 0644 on set 13).  LOS 16's mtk_disp_mgr.0/rgb line is
    # not carried: the 4.9 kernel has no such attribute (FACT, ls on set 13).
    mkdir /data/.tp 0775 system system
    chown system camera /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario
    chmod 0660 /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1248000
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ondemand

# Thermal policy loader and display PQ daemon, as on LOS 16 (los16-ct07
# device/meizu/m5c/rootdir/init.mt6735.rc:774-778, 1148-1151).  FACT (A13,
# set 12): neither was defined, although both blobs are installed —
# thermal_manager path-patched to /odm/etc/thermal.conf and pq wired to
# libm5cshim_legacy (vendor/meizu/m5c Android.mk, treble-elf-wiring.txt).
# fuelgauged stays undefined: this kernel computes the SOC itself
# (CONFIG_MTK_GAUGE_VERSION=10, LOS 16 note at :1153).
service thermal_manager /vendor/bin/thermal_manager
    class main
    user root
    # group system for /data/.tp/.settings (system:system 0660) without
    # CAP_DAC_OVERRIDE, which A13 grants no vendor domain (census set 21).
    group root system
    oneshot

service pq /vendor/bin/pq
    class main
    user system
    group system graphics
    oneshot

# init.mt6735.rc — Meizu M5c (m5c), LOS 20 full Treble: the minimum device rc
# that a first boot needs to be observable (item 7 of "NOT WIRED YET" in
# device.mk, first part).  Lane flash-m5c, 2026-09-28.
#
# Imported by init.rc as /vendor/etc/init/hw/init.${ro.hardware}.rc
# (androidboot.hardware=mt6735).  The LOS 16 rc set is NOT pasted: only what
# a boot to adb needs, each line with its source.  Everything else of
# item 7 (modem, connectivity, cpuset, bluetooth) is still open.
#
# FACT that makes this file load-bearing (flash-m5c-20260928.md §4): without
# it nothing runs mount_all, so /data, /metadata, /protect_f, /protect_s and
# /nvdata are never mounted — first-stage init mounts only the three
# first_stage_mount entries.

import /vendor/etc/init/hw/init.mt6735.usb.rc

on init
    # FACT (boot 4 of 2026-09-28, forge_hwc in place): the default SkiaGL
    # RenderEngine aborts in primeShaderCache with "Unable to generate SkImage.
    # isTextureValid:1 dataspace:513" on this Mali-T720 r7p0 (N-era DDK), SF
    # restarts and takes zygote with it.  With the legacy GLES RenderEngine
    # (set live with setprop) SF stays up and system_server boots.  Same wall
    # and same fix as m95 (device/meizu/m95/rootdir/init.mt6797.rc, "on init":
    # a vendor build.prop entry is dropped, an rc setprop is honoured).
    setprop debug.renderengine.backend gles

    # RT budget for the cpu cgroups init.rc creates above.  This 4.9 kernel
    # has CONFIG_RT_GROUP_SCHED=y (/proc/config.gz), and a new group starts
    # with cpu.rt_runtime_us 0, where the kernel refuses SCHED_FIFO/RR with
    # EPERM even to CAP_SYS_NICE (__sched_setscheduler).  Pie kept every task
    # in the root group (950000); Android 13 moves them into the groups.
    # FACT (A13, set 9, 2026-09-28): every child of /dev/cpuctl had
    # rt_runtime_us 0; surfaceflinger, audioserver, the audio HAL,
    # system_server and com.android.bluetooth sat in cpu:/foreground; BT
    # (CapEff 0x1800803400, CAP_SYS_NICE set) died on each enable with
    #   pthread_create sched_setscheduler(1, {1}) call failed: Operation not permitted
    #   alarm.cc:683 timer_create_internal ... clock 7: Operation not permitted
    #   FATAL:alarm.cc(170) Check failed: false.
    # The children's sum must stay within the root's 950000 (per 1 s period).
    write /dev/cpuctl/foreground/cpu.rt_runtime_us 400000
    write /dev/cpuctl/top-app/cpu.rt_runtime_us 200000
    write /dev/cpuctl/rt/cpu.rt_runtime_us 100000
    write /dev/cpuctl/system/cpu.rt_runtime_us 50000
    write /dev/cpuctl/system-background/cpu.rt_runtime_us 50000
    write /dev/cpuctl/background/cpu.rt_runtime_us 50000
    write /dev/cpuctl/camera-daemon/cpu.rt_runtime_us 50000

on fs
    # The ramdisk copy of the fstab is gone after switch_root (m95 lesson,
    # device/meizu/m95/rootdir/init.mt6797.rc "cannot open file:
    # '/fstab.mt6797'"); the vendor copy is the one init can read.
    # system/vendor/metadata carry first_stage_mount and are skipped here
    # (metadata only if it is already mounted — it is formattable, so an
    # unformatted partition gets formatted here, fs_mgr.cpp:1363-1372).
    # /nvdata, /protect_f, /protect_s exist on the root (BoardConfig.mk
    # BOARD_ROOT_EXTRA_FOLDERS), their entries are nofail.
    mount_all /vendor/etc/fstab.mt6735

on post-fs
    # [LOS 16 ramdisk init.mt6735.rc, on post-fs]
    chown system system /protect_f
    chmod 0770 /protect_f
    chown system system /protect_s
    chmod 0770 /protect_s

on post-fs-data
    # zram swap declared in the fstab (see its comment).  zram-friendly VM
    # knobs as on m95 (init.m95.mem.rc): swap eagerly to compressed RAM
    # rather than evict file pages, no read-ahead clusters on swap-in.
    swapon_all /vendor/etc/fstab.mt6735
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
    # [LOS 16 ramdisk init.mt6735.rc, on post-fs-data] /data/nvram is a
    # symlink to the nvdata partition on this device.  init.m5c.nvram.rc
    # (parsed after this file) copies the fstab into it in the same trigger.
    chown root system /nvdata
    chmod 0771 /nvdata
    symlink /nvdata /data/nvram
    mkdir /nvdata/media 0771 media audio
    restorecon_recursive /nvdata

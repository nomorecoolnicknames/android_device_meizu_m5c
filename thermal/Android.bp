// Thermal HAL 2.0 for the m5c: real temperatures from the MTK thermal zones.

// so the framework saw no temperatures and no throttling status at all.
// Built from hardware/interfaces/thermal/2.0/default (the AOSP mock).
cc_binary {
    name: "android.hardware.thermal@2.0-service.m5c",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.thermal@2.0-service.m5c.rc"],
    vintf_fragments: ["android.hardware.thermal@2.0-service.m5c.xml"],
    srcs: [
        "Thermal.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "android.hardware.thermal@2.0",
        "android.hardware.thermal@1.0",
    ],
}

diff --git a/Android.mk b/Android.mk
index 8b9ea20..1586412 100644
--- a/Android.mk
+++ b/Android.mk
@@ -1,5 +1,25 @@
+# Guarded for the shared LOS16 tree: sibling products (m681, m95, ...) must
+# not define these prebuilt modules — names like libnvram collide.
+ifeq ($(TARGET_DEVICE),m5c)
 LOCAL_PATH := $(call my-dir)
 
+# forge LOS16 (2026-08-28): the libnvram BUILD_PREBUILT block is REMOVED.
+# vendor/meizu/meizu_m6/Android.bp defines a Soong cc_prebuilt_library_shared
+# named "libnvram", and Android.bp files are parsed for EVERY product in the
+# tree — no TARGET_DEVICE guard exists in Soong, so a kati module of the same
+# name here fails the build:
+#   base_rules.mk:260: MODULE.TARGET.SHARED_LIBRARIES.libnvram already
+#   defined by vendor/meizu/meizu_m6
+# Our own libnvram.so (the mt6737m 2016 blob) is installed by
+# m5c-vendor-blobs.mk:141-142 via PRODUCT_COPY_FILES, so no module is needed
+# for installation.
+# LANDMINE for the BT stage: vendor/mediatek/hidl/bluetooth links libnvram by
+# name in Soong, which on an m5c build resolves to the meizu_m6 (mt6755, N)
+# blob, NOT ours. Before shipping android.hardware.bluetooth@1.0-service.mtk,
+# that link must be re-pointed (own bp module under a different name +
+# stem, or a sepolicy/rc-level answer) — do NOT let the mt6755 blob into the
+# m5c image.
+
 include $(CLEAR_VARS)
 LOCAL_MODULE := libdpframework
 LOCAL_MODULE_CLASS := SHARED_LIBRARIES
@@ -12,34 +32,84 @@ LOCAL_SRC_FILES_32 := proprietary/lib/libdpframework.so
 include $(BUILD_PREBUILT)
 
 include $(CLEAR_VARS)
-LOCAL_MODULE := libnvram
+LOCAL_MODULE := libgralloc_extra
 LOCAL_MODULE_CLASS := SHARED_LIBRARIES
 LOCAL_MODULE_OWNER := meizu
 LOCAL_MODULE_SUFFIX := .so
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MULTILIB := both
-LOCAL_SRC_FILES_64 := proprietary/lib64/libnvram.so
-LOCAL_SRC_FILES_32 := proprietary/lib/libnvram.so
+LOCAL_SRC_FILES_64 := proprietary/lib64/libgralloc_extra.so
+LOCAL_SRC_FILES_32 := proprietary/lib/libgralloc_extra.so
 include $(BUILD_PREBUILT)
 
 include $(CLEAR_VARS)
-LOCAL_MODULE := libgralloc_extra
+LOCAL_MODULE := libaudiocustparam
 LOCAL_MODULE_CLASS := SHARED_LIBRARIES
 LOCAL_MODULE_OWNER := meizu
 LOCAL_MODULE_SUFFIX := .so
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MULTILIB := both
-LOCAL_SRC_FILES_64 := proprietary/lib64/libgralloc_extra.so
-LOCAL_SRC_FILES_32 := proprietary/lib/libgralloc_extra.so
+LOCAL_SRC_FILES_64 := proprietary/lib64/libaudiocustparam.so
+LOCAL_SRC_FILES_32 := proprietary/lib/libaudiocustparam.so
 include $(BUILD_PREBUILT)
 
+# librilimp: the stock MediaTek libril — OUR OWN 14.1 m5c blob librilmtk.so
+# (64-bit, md5 941324a6afd634d0e030d13b0191cd55) with its DT_SONAME rewritten
+# to librilimp.so via patchelf --set-soname (result md5
+# e62894d01f9d5678c783ad5c357bbb84). Recipe is the m95 kril lane verbatim
+# (vendor/meizu/m95/Android.mk:31): with BOARD_USES_MTK_HARDWARE=true this
+# tree's hardware/ril/libril also emits a patched libril under the SONAME
+# librilmtk.so, which DT_NEEDEDs librilimp for the modem-internal symbols
+# (IMS_*, isMalSupported, ...) the AOSP libril does not implement. The 32-bit
+# path keeps the stock librilmtk.so from m5c-vendor-blobs.mk untouched.
+# NOTE stage-4: whether m5c telephony goes this instance-unification way (m95)
+# or the vendor/mediatek/ril way (m681) is an open decision; this module only
+# satisfies the link so the tree parses.
 include $(CLEAR_VARS)
-LOCAL_MODULE := libaudiocustparam
+LOCAL_MODULE := librilimp
+LOCAL_MODULE_OWNER := meizu
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_PROPRIETARY_MODULE := true
+LOCAL_MULTILIB := 64
+LOCAL_SRC_FILES := proprietary/lib64/librilimp.so
+include $(BUILD_PREBUILT)
+# Stage 4 (2026-09-03, los16-modem-gps): the stock RIL pair as MODULES, so
+# vendor/mediatek/ril/libril (the MTK Oreo HIDL libril) can link them by name
+# (its Android.mk lists librilmtk and mtk-ril in LOCAL_SHARED_LIBRARIES).
+# Same shape as vendor/meizu/m681/Android.mk:216-234. The matching
+# PRODUCT_COPY_FILES lines (system/lib{,64}/{librilmtk,mtk-ril}.so) are
+# removed from m5c-vendor-blobs.mk in the same change: these install to
+# $(TARGET_OUT_VENDOR)/lib{,64} and the runtime consumers (MTK rild, the MTK
+# libril, mtk-ril.so's own DT_NEEDED librilmtk.so) all resolve through the
+# default namespace search path, which covers /vendor/lib*.
+# FACT (readelf 2026-09-03): the stock 64-bit librilmtk exports every MTK
+# entry the Oreo libril imports (IMS_RIL_onUnsolicitedResponseSocket,
+# IMS_isRilRequestFromIms, IMS_RILA_register, RIL_UpdateToVT, ...), and
+# mtk-ril.so exports RIL_InitSocket/RIL_SAP_Init (no RIL_Init).
+include $(CLEAR_VARS)
+LOCAL_MODULE := librilmtk
+LOCAL_MODULE_OWNER := meizu
+LOCAL_MODULE_TAGS := optional
 LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_PROPRIETARY_MODULE := true
+LOCAL_MULTILIB := both
+LOCAL_SRC_FILES_64 := proprietary/lib64/librilmtk.so
+LOCAL_SRC_FILES_32 := proprietary/lib/librilmtk.so
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := mtk-ril
 LOCAL_MODULE_OWNER := meizu
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
 LOCAL_MODULE_SUFFIX := .so
 LOCAL_PROPRIETARY_MODULE := true
 LOCAL_MULTILIB := both
-LOCAL_SRC_FILES_64 := proprietary/lib64/libaudiocustparam.so
-LOCAL_SRC_FILES_32 := proprietary/lib/libaudiocustparam.so
+LOCAL_SRC_FILES_64 := proprietary/lib64/mtk-ril.so
+LOCAL_SRC_FILES_32 := proprietary/lib/mtk-ril.so
 include $(BUILD_PREBUILT)
+
+endif

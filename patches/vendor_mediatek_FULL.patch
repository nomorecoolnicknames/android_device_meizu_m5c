+ * is immediately followed by unsolResponse=3043 with datalen=80 - ten string
+ * pointers, i.e. the ECPI fields - and RIL_UNSOL_CALL_INFO_INDICATION is never
+ * raised at all (grep count zero across the whole capture), so the earlier
+ * acknowledgement placed in callInfoInd could never fire.
+ *
+ * Our header names 3043 RIL_UNSOL_CIPHER_INDICATION and the unsol table left
+ * its handler NULL, which is why the payload was dropped. The m95 VoLTE guide
+ * names the same number as the +ECPI notification, "the whole call state
+ * machine", and the measurement agrees with the guide rather than with our
+ * header. The id is shared; discriminate on the payload before trusting it,
+ * the same rule incomingCallInd() already follows for its own reused id.
+ *
+ * On the message that carries the caller's number the modem stalls until it
+ * gets SET_CALL_INDICATION back with the same call id and sequence number -
+ * without it the stream stops dead, which is exactly what three calls showed.
+ * Call id is field 0 and the sequence number the trailing field, both taken
+ * from the message. The contract's first argument, "mode", is derivable from
+ * no field here, so it stays a runtime knob rather than a guess in the image.
+ */
+int radio::forgeEcpiInd(int slotId,
+                        int indicationType, int token, RIL_Errno e, void *response,
+                        size_t responseLen) {
+    if (response == NULL) return 0;
+
+    /* responseLen is a count of pointers in some of these MTK unsols and a byte
+     * length in others; accept both rather than pick one. */
+    size_t nfields = (responseLen >= sizeof(char *)
+                      && (responseLen % sizeof(char *)) == 0)
+                     ? responseLen / sizeof(char *)
+                     : responseLen;
+    if (nfields < 10 || nfields > 32) return 0;
+
+    char **strings = (char **) response;
+    if (strings[0] == NULL || strings[1] == NULL) return 0;
+    if (strcmp(strings[1], "133") != 0) return 0;      /* incoming, with number */
+
+    char modeProp[PROPERTY_VALUE_MAX] = {0};
+    int mode = 1;
+    if (property_get("persist.m681.ril.callind_mode", modeProp, NULL) > 0) {
+        mode = atoi(modeProp);
+    }
+    int callId = atoi(strings[0]);
+    int seq = (strings[nfields - 1] != NULL) ? atoi(strings[nfields - 1]) : 0;
+
+    RLOGI("forge ECPI: incoming call id=%d seq=%d fields=%zu -> SET_CALL_INDICATION mode=%d",
+          callId, seq, nfields, mode);
+    dispatchInts(-1, slotId, RIL_REQUEST_SET_CALL_INDICATION, 3, mode, callId, seq);
+    return 0;
